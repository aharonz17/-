# ============================================================================
#  עוזר קולי אישי — קובץ הגדרות לדוגמה
#  העתק לקובץ .env ומלא ערכים אמיתיים. אל תכניס סודות אמיתיים לקובץ הזה.
#  (אפיון, דרישה 15: Secrets לעולם לא בקוד)
# ============================================================================

# --- שרת ---------------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# סוד משותף שימות חייבת לצרף לכתובת ה-webhook.
# בשלוחה מגדירים: api_link=https://your-host/yemot/<הערך הזה>
# בלי זה, כל מי שמכיר את הכתובת יכול לזייף שיחות.
# צור ערך אקראי: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=

# --- ימות המשיח --------------------------------------------------------------
# פורמט הטוקן: <מספר-מערכת>:<סיסמת-ניהול>   לדוגמה 0773123456:1234
# זו אותה סיסמה שבה נכנסים לפאנל הניהול של ימות.
# מאותם פרטים המערכת מתחברת גם ב-Login כשנדרש טוקן סשן — ראה README.
YEMOT_TOKEN=

# מספר הטלפון היחיד שמורשה להשתמש במערכת (אפיון, דרישה 16).
# הבדיקה נעשית בצד השרת ולא נסמכת על הגדרת ה-IVR.
AUTHORIZED_PHONE=

# הנתיב בתוך מערכת ימות שאליו נשמרות ההקלטות.
# חייב להתחיל ב-/ ואסור שיסתיים ב-/  (אילוץ של ימות)
YEMOT_RECORDINGS_PATH=/1

# מזהה השיחה היוצאת (Caller ID) לתזכורות. ריק = ברירת המחדל של המערכת.
YEMOT_CALLER_ID=

# --- Google ------------------------------------------------------------------
GOOGLE_PROJECT_ID=
# נתיב לקובץ service account JSON. הקובץ עצמו לא נכנס ל-git.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# מפתח Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash סגור למשתמשים חדשים (נבדק 04/10/2026)
GEMINI_MODEL=gemini-3.5-flash

# מזהה תיקיית השורש ב-Drive שבה יישמרו ההקלטות
GOOGLE_DRIVE_FOLDER_ID=
# מזהה הגיליון המשמש כמראה לתצוגה
GOOGLE_SHEET_ID=
# מזהה תיקיית ה-Docs שבה ייווצר מסמך היומן החודשי
GOOGLE_DOCS_FOLDER_ID=

# --- התנהגות -----------------------------------------------------------------
TIMEZONE=Asia/Jerusalem

# המנוע שרץ בשיחה חיה. שתי אפשרויות:
#
#   elevenlabs+qwen  ElevenLabs שומע, Qwen על Groq מבין. דורש ELEVENLABS_API_KEY
#                    ו-GROQ_API_KEY, שניהם בחינם. הנבחר במדידה על הקלטות טלפון
#                    אמיתיות: 13/21 נכונים, 9/10 שעות נכונות. כשתי שניות לתשובה.
#   gemini           קריאה אחת לשמיעה ולהבנה. מאז 2026 דורש חשבון בתשלום מראש.
ACTIVE_TRANSCRIBER=elevenlabs+qwen

# --- מנועי תמלול להשוואה ב-benchmark -------------------------------------
# המפתחות של המסלול elevenlabs+qwen. כל המנועים כאן נמדדים גם ב-
# npm run benchmark על הקלטות טלפון אמיתיות. ראה STATUS.md

# Groq — https://console.groq.com/keys  (חינם, בלי כרטיס אשראי)
# המפתח משמש את שלב ההבנה (GROQ_TEXT_MODEL) ואת Whisper להשוואה (GROQ_MODEL).
# Whisper של Groq נמדד כחלש בעברית טלפונית: 6/21. לא מומלץ כמנוע שמיעה.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=qwen/qwen3.8-27b

# ElevenLabs Scribe — https://elevenlabs.io/app/settings/api-keys
# הרשאה נדרשת למפתח: Speech to Text בלבד.
# מכסה חינמית: 10,000 קרדיטים בחודש, כ-30 דקות אודיו. לשימוש אישי בלבד, לא מסחרי.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2

MAX_RECORDING_SECONDS=60
MIN_RECORDING_SECONDS=1

# תקציב זמן תגובה. מעליו מושמעת הודעת המתנה למשתמש.
RESPONSE_BUDGET_MS=3000

# תזכורות — כמה פעמים לחייג כשאין מענה.
#
# ברירת המחדל היא 1: חיוג אחד, ואם לא אישרת — התזכורת עוברת להמתנה
# ותושמע לך בשיחה הנכנסת הבאה. היא לא הולכת לאיבוד.
# העלאת הערך מגדילה את עלות החיוג היוצא באותה מידה.
REMINDER_RETRY_COUNT=1

# מרווחי ההמתנה בין ניסיונות (דקות) — רלוונטי רק אם RETRY_COUNT גדול מ-1
REMINDER_RETRY_DELAYS_MINUTES=5,15

# מכמה תזכורות ממתינות ואילך המערכת תשאל "לשמוע הקש 1, לדלג הקש 2"
# במקום להשמיע אותן ישר. תזכורת בודדת תמיד מושמעת ישר.
REMINDER_INBOX_ASK_THRESHOLD=2

# חיוג יוצא לתזכורות. כבוי עד אימות מול ימות — ראה STATUS.md
REMINDERS_OUTBOUND_ENABLED=false

# דחיית תזכורת (Snooze) בדקות — מקש 2 ומקש 3 בשיחה החוזרת.
SNOOZE_SHORT_MINUTES=10
SNOOZE_LONG_MINUTES=60

# --- אחסון -------------------------------------------------------------------
DATABASE_PATH=./data/assistant.sqlite
